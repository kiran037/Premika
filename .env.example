# ======================================================
# Premika Ecommerce - Environment Configuration Guide
# ======================================================

# Database Connection (PostgreSQL / Supabase / Neon)
DATABASE_URL=postgresql://postgres:password@localhost:5432/premika_db

# Admin Authentication & Security
ADMIN_JWT_SECRET=super_secret_jwt_key_change_in_production_min_32_chars

# Application URL
NEXT_PUBLIC_APP_URL=https://premika.shop

# Google Analytics (Optional)
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Razorpay Payment Gateway Credentials
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Transactional Email Configuration (Gmail / SMTP / Nodemailer)
GMAIL_USER=contact@premika.shop
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# Build & Runtime Environment
NODE_ENV=production

# Delhivery Logistics Configuration
DELHIVERY_API_URL=https://track.delhivery.com
DELHIVERY_API_TOKEN=your_delhivery_api_token_here
DELHIVERY_WEBHOOK_SECRET=your_delhivery_webhook_secret_here
